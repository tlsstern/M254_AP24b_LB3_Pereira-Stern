<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Mitarbeiter" name="Mitarbeiter/in" processRef="Process_Mitarbeiter" />
    <bpmn:participant id="Participant_Vorgesetzter" name="Vorgesetzte/r" processRef="Process_Vorgesetzter" />
    <bpmn:participant id="Participant_HR" name="HR-System" processRef="Process_HR" />
    <bpmn:messageFlow id="Msg_AntragSenden" name="Urlaubsantrag" sourceRef="Task_AntragEinreichen" targetRef="Start_VG" />
    <bpmn:messageFlow id="Msg_EntscheidAnMA" name="Entscheid" sourceRef="Task_EntscheidSenden" targetRef="Event_EntscheidErhalten" />
    <bpmn:messageFlow id="Msg_HR_Notify" name="HR-Benachrichtigung" sourceRef="Task_HR_Benachrichtigen" targetRef="Start_HR" />
    <bpmn:messageFlow id="Msg_Bestaetigung" name="Bestätigung" sourceRef="Task_Bestaetigung" targetRef="Event_HR_BestaetigungErhalten" />
  </bpmn:collaboration>
  <bpmn:message id="msg_urlaubsantrag" name="msg_urlaubsantrag" />
  <bpmn:message id="msg_entscheid" name="msg_entscheid">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=antragId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="msg_hr_benachrichtigung" name="msg_hr_benachrichtigung" />
  <bpmn:message id="msg_bestaetigung" name="msg_bestaetigung">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=antragId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="Process_Mitarbeiter" name="Mitarbeiter/in" isExecutable="true">
    <bpmn:startEvent id="Start_MA" name="Urlaub benötigt">
      <bpmn:documentation>Initialer Startpunkt für den Urlaubsantrag.</bpmn:documentation>
      <bpmn:outgoing>F_MA1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AntragAusfuellen" name="Urlaubsantrag ausfüllen">
      <bpmn:incoming>F_MA1</bpmn:incoming>
      <bpmn:incoming>F_MA9</bpmn:incoming>
      <bpmn:outgoing>F_MA2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_AntragEinreichen" name="Antrag einreichen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-antrag" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_MA2</bpmn:incoming>
      <bpmn:outgoing>F_MA3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_EntscheidErhalten" name="Entscheid erhalten">
      <bpmn:incoming>F_MA3</bpmn:incoming>
      <bpmn:outgoing>F_MA4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_4" messageRef="msg_entscheid" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_Entscheid_MA" name="Genehmigt?">
      <bpmn:incoming>F_MA4</bpmn:incoming>
      <bpmn:outgoing>F_MA5</bpmn:outgoing>
      <bpmn:outgoing>F_MA6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_HR_BestaetigungErhalten" name="HR-Bestätigung erhalten">
      <bpmn:incoming>F_MA5</bpmn:incoming>
      <bpmn:outgoing>F_MA7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_7" messageRef="msg_bestaetigung" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_UrlaubPlanen" name="Urlaub planen">
      <bpmn:incoming>F_MA7</bpmn:incoming>
      <bpmn:outgoing>F_MA11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Merge_Antrag" name="">
      <bpmn:incoming>F_MA1</bpmn:incoming>
      <bpmn:incoming>F_MA9</bpmn:incoming>
      <bpmn:outgoing>F_MA_Merge_Antrag_Out</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AntragAnpassen" name="Antrag anpassen oder verzichten">
      <bpmn:incoming>F_MA6</bpmn:incoming>
      <bpmn:outgoing>F_MA8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_MA_Genehmigt" name="Urlaub genehmigt">
      <bpmn:incoming>F_MA11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_MA_Abgelehnt" name="Antrag zurückgezogen">
      <bpmn:incoming>F_MA10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Anpassen" name="Erneut einreichen?">
      <bpmn:incoming>F_MA8</bpmn:incoming>
      <bpmn:outgoing>F_MA9</bpmn:outgoing>
      <bpmn:outgoing>F_MA10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_MA1" name="" sourceRef="Start_MA" targetRef="Gw_Merge_Antrag" />
    <bpmn:sequenceFlow id="F_MA_Merge_Antrag_Out" name="" sourceRef="Gw_Merge_Antrag" targetRef="Task_AntragAusfuellen" />
    <bpmn:sequenceFlow id="F_MA2" name="" sourceRef="Task_AntragAusfuellen" targetRef="Task_AntragEinreichen" />
    <bpmn:sequenceFlow id="F_MA3" name="" sourceRef="Task_AntragEinreichen" targetRef="Event_EntscheidErhalten" />
    <bpmn:sequenceFlow id="F_MA4" name="" sourceRef="Event_EntscheidErhalten" targetRef="Gw_Entscheid_MA" />
    <bpmn:sequenceFlow id="F_MA5" name="Ja" sourceRef="Gw_Entscheid_MA" targetRef="Event_HR_BestaetigungErhalten">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_MA6" name="Nein" sourceRef="Gw_Entscheid_MA" targetRef="Task_AntragAnpassen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_MA7" name="" sourceRef="Event_HR_BestaetigungErhalten" targetRef="Task_UrlaubPlanen" />
    <bpmn:sequenceFlow id="F_MA11" name="" sourceRef="Task_UrlaubPlanen" targetRef="End_MA_Genehmigt" />
    <bpmn:sequenceFlow id="F_MA9" name="Ja" sourceRef="Gw_Anpassen" targetRef="Gw_Merge_Antrag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retry = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_MA8" name="" sourceRef="Task_AntragAnpassen" targetRef="Gw_Anpassen" />
    <bpmn:sequenceFlow id="F_MA10" name="Nein" sourceRef="Gw_Anpassen" targetRef="End_MA_Abgelehnt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=retry = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process_Vorgesetzter" name="Vorgesetzte/r" isExecutable="true">
    <bpmn:startEvent id="Start_VG" name="Urlaubsantrag erhalten">
      <bpmn:outgoing>F_VG1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_5" messageRef="msg_urlaubsantrag" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_AntragPruefen" name="Antrag prüfen">
      <bpmn:incoming>F_VG1</bpmn:incoming>
      <bpmn:outgoing>F_VG2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Ablehnen" name="Ablehnung mitteilen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_VG4</bpmn:incoming>
      <bpmn:outgoing>F_VG6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Genehmigen" name="Genehmigung erteilen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="approve-request" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_VG3</bpmn:incoming>
      <bpmn:outgoing>F_VG5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Merge_VG" name="">
      <bpmn:incoming>F_VG5</bpmn:incoming>
      <bpmn:incoming>F_VG6</bpmn:incoming>
      <bpmn:outgoing>F_VG_Merge_Out</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_EntscheidSenden" name="Entscheid an Mitarbeiter senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_VG_Merge_Out</bpmn:incoming>
      <bpmn:outgoing>F_VG7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_HR_Benachrichtigen" name="HR-System benachrichtigen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-hr" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_VG7</bpmn:incoming>
      <bpmn:outgoing>F_VG8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_VG" name="Bearbeitung abgeschlossen">
      <bpmn:incoming>F_VG8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Genehmigung" name="Genehmigen?">
      <bpmn:incoming>F_VG2</bpmn:incoming>
      <bpmn:outgoing>F_VG3</bpmn:outgoing>
      <bpmn:outgoing>F_VG4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F_VG1" name="" sourceRef="Start_VG" targetRef="Task_AntragPruefen" />
    <bpmn:sequenceFlow id="F_VG2" name="" sourceRef="Task_AntragPruefen" targetRef="Gw_Genehmigung" />
    <bpmn:sequenceFlow id="F_VG4" name="Nein" sourceRef="Gw_Genehmigung" targetRef="Task_Ablehnen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_VG6" name="" sourceRef="Task_Ablehnen" targetRef="Gw_Merge_VG" />
    <bpmn:sequenceFlow id="F_VG3" name="Ja" sourceRef="Gw_Genehmigung" targetRef="Task_Genehmigen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_VG5" name="" sourceRef="Task_Genehmigen" targetRef="Gw_Merge_VG" />
    <bpmn:sequenceFlow id="F_VG_Merge_Out" name="" sourceRef="Gw_Merge_VG" targetRef="Task_EntscheidSenden" />
    <bpmn:sequenceFlow id="F_VG7" name="" sourceRef="Task_EntscheidSenden" targetRef="Task_HR_Benachrichtigen" />
    <bpmn:sequenceFlow id="F_VG8" name="" sourceRef="Task_HR_Benachrichtigen" targetRef="End_VG" />
  </bpmn:process>
  <bpmn:process id="Process_HR" name="HR-System" isExecutable="true">
    <bpmn:startEvent id="Start_HR" name="Benachrichtigung erhalten">
      <bpmn:outgoing>F_HR1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="EventDef_6" messageRef="msg_hr_benachrichtigung" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_HR_Entscheid" name="Genehmigt?">
      <bpmn:incoming>F_HR1</bpmn:incoming>
      <bpmn:outgoing>F_HR2</bpmn:outgoing>
      <bpmn:outgoing>F_HR3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DB_Eintrag" name="Urlaubstage in Datenbank eintragen">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-db" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_HR2</bpmn:incoming>
      <bpmn:outgoing>F_HR4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Bestaetigung" name="Bestätigung an Mitarbeiter senden">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-confirmation" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_HR4</bpmn:incoming>
      <bpmn:outgoing>F_HR5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Ablehnung_Loggen" name="Ablehnung protokollieren">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="log-rejection" />
      </bpmn:extensionElements>
      <bpmn:incoming>F_HR3</bpmn:incoming>
      <bpmn:outgoing>F_HR6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Merge_HR" name="">
      <bpmn:incoming>F_HR5</bpmn:incoming>
      <bpmn:incoming>F_HR6</bpmn:incoming>
      <bpmn:outgoing>F_HR_Merge_Out</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_HR" name="HR-Vorgang abgeschlossen">
      <bpmn:incoming>F_HR_Merge_Out</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_HR1" name="" sourceRef="Start_HR" targetRef="Gw_HR_Entscheid" />
    <bpmn:sequenceFlow id="F_HR2" name="Ja" sourceRef="Gw_HR_Entscheid" targetRef="Task_DB_Eintrag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_HR3" name="Nein" sourceRef="Gw_HR_Entscheid" targetRef="Task_Ablehnung_Loggen">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_HR4" name="" sourceRef="Task_DB_Eintrag" targetRef="Task_Bestaetigung" />
    <bpmn:sequenceFlow id="F_HR5" name="" sourceRef="Task_Bestaetigung" targetRef="Gw_Merge_HR" />
    <bpmn:sequenceFlow id="F_HR6" name="" sourceRef="Task_Ablehnung_Loggen" targetRef="Gw_Merge_HR" />
    <bpmn:sequenceFlow id="F_HR_Merge_Out" name="" sourceRef="Gw_Merge_HR" targetRef="End_HR" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
